# Neon: the "-pooler" connection string. Supabase: the transaction pooler (port 6543).
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection, used only by `prisma migrate`.
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

FRONTEND_URL="https://my-frontend.vercel.app"
PUBLIC_URL="https://your-app-name.koyeb.app"

# From the Etsy developer portal (Your Apps -> webhooks).
ETSY_WEBHOOK_SECRET="whsec_..."
# x-api-key header value: "<keystring>:<shared secret>"
ETSY_API_KEY="keystring:sharedsecret"
ETSY_CLIENT_ID="keystring"
ETSY_SHOP_ID="12345678"
# From the one-time OAuth flow (scopes: transactions_r transactions_w).
# Only read until the first refresh; after that the token lives in the database.
ETSY_REFRESH_TOKEN="12345678.xxxx"

# Optional
# DATA_DIR=/tmp/cbn-data
# MAX_UPLOAD_MB=15
# PROCESS_TIMEOUT_SEC=300
# LOG_LEVEL=info
